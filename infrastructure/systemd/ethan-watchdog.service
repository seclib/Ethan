[Unit]
Description=ETHAN Container Watchdog — Monitor crashed containers
Documentation=https://github.com/seclib/Ethan/docs
After=network-online.target docker.service ethan-core.service
Requires=docker.service

# Ce service est déclenché par ethan-watchdog.timer (toutes les 30s).
# Il vérifie l'état des conteneurs ETHAN et tente de redémarrer
# ceux qui ont crashé, ou alerte via le journal systemd.

[Service]
Type=exec
User=ethan
SupplementaryGroups=docker
Environment=ETHAN_ROOT=/home/fatsio/AI/Ethan
# Variables du circuit breaker, surchargeables via .env (EnvironmentFile) :
#   ETHAN_WATCHDOG_MAX_RESTARTS=5                   # échecs consécutifs avant ouverture du circuit
#   ETHAN_WATCHDOG_STATE=/tmp/ethan-watchdog-state  # fichier d'état (compteurs par service)
EnvironmentFile=-/home/fatsio/AI/Ethan/.env
WorkingDirectory=/home/fatsio/AI/Ethan
ExecStart=/home/fatsio/AI/Ethan/ethan watchdog
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethan-watchdog

[Install]
WantedBy=multi-user.target
