[Unit]
Description=ETHAN Core — Services Docker
Documentation=https://github.com/seclib/Ethan/docs
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ethan up
ExecStop=/usr/local/bin/ethan down
ExecReload=/usr/local/bin/ethan restart
User=ethan
Group=docker

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ethan /var/log/ethan

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethan

[Install]
WantedBy=multi-user.target