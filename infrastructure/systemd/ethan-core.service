[Unit]
Description=ETHAN Cognitive OS — Stack Docker Compose
Documentation=https://github.com/seclib/Ethan/docs
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

# ──────────────────────────────────────────────────────────────────
# POURQUOI Type=oneshot RemainAfterExit=yes ?
#
# docker compose up -d est une commande qui lance les conteneurs en
# arrière-plan et se termine immédiatement. Il n'y a pas de processus
# parent à superviser.
#
# LIMITATION DOCUMENTÉE : systemd voit ce service comme "actif" même
# si 3 conteneurs sur 7 ont crashé. La vraie supervision est assurée
# par Docker lui-même (restart: unless-stopped) et par ethan-watchdog.timer.
#
# SOLUTION COMPLÈTE : voir ethan-watchdog.timer (toutes les 30s)
# ──────────────────────────────────────────────────────────────────
[Service]
Type=oneshot
RemainAfterExit=yes

# ── Chemins absolus ───────────────────────────────────────────────
# ETHAN_ROOT doit pointer vers l'emplacement réel du projet.
# Installation ETHAN active sur cette machine.
Environment=ETHAN_ROOT=/home/fatsio/AI/Ethan
EnvironmentFile=-/home/fatsio/AI/Ethan/.env
WorkingDirectory=/home/fatsio/AI/Ethan

# ── Démarrage avec préflight ───────────────────────────────────────
# Le préflight vérifie les ports et les prérequis avant le vrai démarrage.
# En cas d'échec du préflight, le service ne démarre pas.
ExecStartPre=/home/fatsio/AI/Ethan/ethan preflight
ExecStart=/home/fatsio/AI/Ethan/ethan up --skip-preflight
ExecStop=/home/fatsio/AI/Ethan/ethan down
ExecReload=/home/fatsio/AI/Ethan/ethan restart

# ── Politique de redémarrage ───────────────────────────────────────
Restart=on-failure
RestartSec=30

# ── Timeout ───────────────────────────────────────────────────────
TimeoutStartSec=600
TimeoutStopSec=90

# ── Utilisateur ────────────────────────────────────────────────────
User=ethan
SupplementaryGroups=docker
# Group=docker  ← NE PAS UTILISER : équivaut à un accès root complet.
# SupplementaryGroups=docker est plus sécurisé (PID-specific).

# ── Sécurité ───────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/fatsio/AI/Ethan /var/lib/ethan /var/log/ethan

# ── Logging ────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethan-core

[Install]
WantedBy=multi-user.target
