# core/models/, interfaces/api/models/ or interfaces/webui/.../models/)
/data/
/memory/
/models/
/embeddings/
/cache/
/uploads/
# Exception : interfaces/api/models/ contient du code source Python
# (schémas Pydantic requis par les routeurs API) — ne pas ignorer.
!interfaces/api/models/
!interfaces/api/models/**
# Exception : core/security/data/ est du code source Python
# (anti-exfiltration importé par prompt_guard/integration) — ne pas ignorer.
!core/security/data/
!core/security/data/**

