[Unit]
Description=ETHAN Core AI Engine
Documentation=https://github.com/seclib/Ethan/docs
After=network-online.target ethan-runtime.service
Wants=network-online.target ethan-runtime.service

[Service]
Type=simple
User=ethan
Group=ethan

Environment="PYTHONPATH=@ETHAN_ROOT@"
Environment="PYTHONDONTWRITEBYTECODE=1"
WorkingDirectory=@ETHAN_ROOT@

ExecStart=/usr/local/bin/ethan-core

Restart=on-failure
RestartSec=10
TimeoutStartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethan-core

[Install]
WantedBy=multi-user.target
