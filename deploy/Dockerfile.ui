# Stage 1: Build Next.js app
FROM node:20-alpine AS builder
WORKDIR /app

# ETHAN_API_URL is used at BUILD TIME by next.config.js rewrites.
# Default to localhost for local builds; override via --build-arg in Docker Compose.
ARG ETHAN_API_URL=http://localhost:8000
ENV ETHAN_API_URL=${ETHAN_API_URL}

COPY interfaces/webui/package.json interfaces/webui/package-lock.json* /app/
RUN npm ci --no-audit --no-fund --legacy-peer-deps || npm install --no-audit --no-fund --legacy-peer-deps
COPY interfaces/webui/ /app/
RUN npm run build

# Stage 2: Production runtime
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /app/.next/ /app/.next/
COPY --from=builder --chown=node:node /app/node_modules/ /app/node_modules/
COPY --from=builder --chown=node:node /app/package.json /app/
COPY --from=builder --chown=node:node /app/public/ /app/public/
EXPOSE 3001
# ── Exécution non-root (hardening) : l'utilisateur `node` (uid 1000) de
# l'image officielle possède les sources ; Next écrit ses caches en home.
USER node
CMD ["npm", "run", "start"]
