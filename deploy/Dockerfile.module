# syntax=docker/dockerfile:1.4
# ─────────────────────────────────────────────────────────────────────────────
# ETHAN — Modules (exécution des capacités cognitives)
# Hérite de ethan/python-base. Aucune réinstallation de dépendances.
# ─────────────────────────────────────────────────────────────────────────────
FROM ethan/python-base:latest

# ── Code spécifique aux modules ──────────────────────────────────────────
COPY plugins/ /app/plugins/
COPY core/   /app/core/
COPY sdk/    /app/sdk/

ENV PYTHONPATH=/app/core:/app/sdk:/app

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD python -c "import asyncio, os, nats; asyncio.run(asyncio.wait_for(nats.connect(os.environ.get('NATS_URL','nats://nats:4222')).__aenter__(), timeout=2))" || exit 1

CMD ["python", "-m", "core.modules"]