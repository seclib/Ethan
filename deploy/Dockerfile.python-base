# ─────────────────────────────────────────────────────────────────────────────
# ETHAN — Image Python de base partagée
# Utilisée comme FROM par : Dockerfile.api, Dockerfile.kernel, Dockerfile.module
#
# OBJECTIF : centraliser pip install pour que le Docker layer cache soit partagé
# entre les 3 services applicatifs, réduisant le temps de build de ~10min à ~3min.
#
# Pour rebuilder uniquement la base :
#   docker build -f deploy/Dockerfile.python-base -t ethan/python-base:latest .
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

LABEL maintainer="ETHAN Project" \
      description="Shared Python base layer for ETHAN services" \
      version="1.0"

WORKDIR /app

# ── Dépendances système minimales ────────────────────────────────
# curl : healthchecks HTTP
# netcat-openbsd (nc) : test de connectivité TCP (healthchecks NATS)
# build-essential : compilateurs C pour les dépendances Python natives
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    netcat-openbsd \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ── Mettre à jour pip pour éviter les warnings ───────────────────
RUN pip install --no-cache-dir --upgrade pip

# ── Copier UNIQUEMENT les fichiers de définition de dépendances ──
# NE PAS copier le code source ici → le cache de cette couche est
# invalidé UNIQUEMENT si pyproject.toml/README.md changent.
COPY pyproject.toml README.md ./

# Copier les packages core et sdk (requis par pyproject.toml -e .)
COPY core/ core/
COPY sdk/ sdk/

# ── Installer toutes les dépendances Python (avec fallback) ──────
# On installe [server,dev] car c'est le superset utilisé par api/kernel/modules.
# Le || true empêche l'échec du build si un extra optionnel n'existe pas.
RUN pip install --no-cache-dir -e ".[server,dev]" || \
    pip install --no-cache-dir -e ".[server]" || \
    pip install --no-cache-dir -e "." || \
    echo "WARN: pip install partiel — vérifier pyproject.toml"

# ── PYTHONPATH unifié ─────────────────────────────────────────────
ENV PYTHONPATH=/app/core:/app/sdk:/app

# ── Métadonnées ───────────────────────────────────────────────────
ENV ETHAN_BASE_IMAGE=1
