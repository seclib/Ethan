# ─────────────────────────────────────────────────────────────────────────────
# ETHAN — Kernel (moteur cognitif central)
# Même stratégie de cache que Dockerfile.api
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Dépendances (couche stable, invalidée uniquement si pyproject.toml change)
COPY pyproject.toml README.md ./
COPY core/ core/
COPY sdk/ sdk/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[server,dev]" || \
    pip install --no-cache-dir -e ".[server]" || \
    pip install --no-cache-dir -e "." || \
    echo "WARN: pip install partiel"

ENV PYTHONPATH=/app/core:/app/sdk:/app

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=20s \
    CMD python - <<'PY' || exit 1
try:
    import asyncio, os, nats
    async def _c():
        nc = await nats.connect(os.environ.get('NATS_URL', 'nats://nats:4222'), timeout=2)
        await nc.close()
    asyncio.run(_c())
except Exception:
    raise SystemExit(1)
PY

CMD ["python", "core/bootstrap.py"]