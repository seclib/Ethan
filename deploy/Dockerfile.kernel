# ─────────────────────────────────────────────────────────────────────────────
# ETHAN — Kernel (moteur cognitif central)
# Hérite de ethan/python-base. Aucune réinstallation de dépendances.
# ─────────────────────────────────────────────────────────────────────────────
FROM ethan/python-base:latest

# ── Code du kernel et de ses dépendances ────────────────────────────────
# Copier le package complet évite qu'une couche de base périmée ne réinjecte
# un bus, un backend d'état ou un scheduler différent du kernel.
COPY core/   /app/core/
COPY sdk/    /app/sdk/

ENV PYTHONPATH=/app/core:/app/sdk:/app

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=20s \
    CMD curl -fsS http://localhost:8080/health/ready || exit 1

CMD ["python", "core/ethan_bootstrap.py"]
