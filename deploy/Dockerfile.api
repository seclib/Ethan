# ─────────────────────────────────────────────────────────────────────────────
# ETHAN — API Gateway
# Hérite de ethan/python-base (pip install + system deps + core/ + sdk/ partagés)
#
# Build :
#   docker build -f deploy/Dockerfile.python-base -t ethan/python-base:latest .
#   docker build -f deploy/Dockerfile.api          -t ethan/api:latest .
# ─────────────────────────────────────────────────────────────────────────────
ARG BASE_IMAGE=ethan/python-base:latest
FROM ${BASE_IMAGE}

# ── Code de l'API et des contrats partagés ───────────────────────────────────
# Le code core est recopié ici pour ne pas dépendre d'un cache de base ancien.
COPY core/ core/
COPY sdk/ sdk/
COPY interfaces/api/ interfaces/api/
COPY cookbook/ cookbook/

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONPATH=/app/core:/app/interfaces/api:/app/sdk:/app

# ── Exécution non-root (hardening) ──────────────────────────────────────────
# /app reste en lecture seule pour ethan (755) ; le home (/home/ethan) reçoit
# l'état écrit par le Core (~/.ethan). Aucune écriture n'est attendue dans /app.
RUN useradd --system --create-home --uid 10001 ethan
USER ethan

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -fsS http://localhost:8000/health/ready || exit 1

CMD ["sh", "-c", "until pg_isready -h postgres -p 5432 -U ethan; do echo 'Waiting for PostgreSQL...'; sleep 2; done; uvicorn interfaces.api.main:app --host 0.0.0.0 --port 8000 --workers 1"]
